    {
      "name": "Webhook",
      "item": [
        {
          "name": "Notificacao Mercado Pago",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "url": {
              "raw": "{{url}}/billing/webhooks/mercado-pago?data.id={{orderId}}&type=order",
              "protocol": "",
              "host": [
                "{{url}}"
              ],
              "path": [
                "billing",
                "webhooks",
                "mercado-pago?data.id={{orderId}}&type=order"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"type\": \"order\", \"action\": \"order.processed\", \"data\": { \"id\": \"{{orderId}}\" } }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Mesmo manifesto do Mercado Pago: id:<data.id em minúsculas>;request-id:<x-request-id>;ts:<ts em ms>;",
                  "const segredo = pm.environment.get(\"webhookSecret\");",
                  "const dataId = String(pm.environment.get(\"orderId\")).toLowerCase();",
                  "const requestId = pm.variables.replaceIn(\"{{$guid}}\");",
                  "const ts = String(Date.now());",
                  "const v1 = CryptoJS.HmacSHA256(`id:${dataId};request-id:${requestId};ts:${ts};`, segredo).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: \"x-request-id\", value: requestId });",
                  "pm.request.headers.upsert({ key: \"x-signature\", value: `ts=${ts},v1=${v1}` });"
                ]
              }
            }
          ]
        }
      ]
    }
