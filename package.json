{
	"name": "oficina-billing-service",
	"version": "1.0.0",
	"description": "Orçamentos e pagamentos da oficina mecânica (microsserviço billing)",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:prod": "node dist/main.js",
		"format": "prettier --write .",
		"lint": "eslint \"{src,test}/**/*.ts\" --fix",
		"lint:check": "eslint \"{src,test}/**/*.ts\"",
		"test": "jest",
		"test:cov": "jest --coverage",
		"test:integracao": "jest --config ./test/jest-integracao.json --runInBand",
		"sonar:up": "docker compose -f dev/docker-compose.yml up -d sonarqube",
		"sonar:down": "docker compose -f dev/docker-compose.yml stop sonarqube",
		"sonar:scan": "bash scripts/sonar-quality-gate.sh",
		"ministack:up": "docker compose -f dev/docker-compose.yml up -d ministack",
		"ministack:down": "docker compose -f dev/docker-compose.yml stop ministack"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1157.0",
		"@aws-sdk/client-sns": "^3.1157.0",
		"@aws-sdk/client-sqs": "^3.1157.0",
		"@aws-sdk/lib-dynamodb": "^3.1157.0",
		"@nestjs/common": "^11.2.8",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.8",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/platform-express": "^11.2.8",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.4.7",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"nestjs-pino": "^4.6.1",
		"newrelic": "^14.9.0",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"semantic-response": "^1.0.4"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.8",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.20.5",
		"@types/supertest": "^6.0.3",
		"aws-sdk-client-mock": "^4.1.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^16.5.0",
		"jest": "^30.5.2",
		"jest-cucumber": "^4.5.0",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.10",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.1",
		"testcontainers": "^12.2.1",
		"ts-jest": "^29.4.15",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"roots": [
			"<rootDir>/src",
			"<rootDir>/test/bdd"
		],
		"testRegex": ".*.(spec|steps).ts$",
		"transform": {
			"^.+.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"src/**/*.ts",
			"!src/**/*.spec.ts"
		],
		"coveragePathIgnorePatterns": [
			"/node_modules/",
			"<rootDir>/src/main.ts",
			".module.ts$",
			".dto.ts$"
		],
		"coverageDirectory": "coverage",
		"coverageReporters": [
			"text",
			"text-summary",
			"lcov",
			"json-summary"
		],
		"testEnvironment": "node",
		"coverageThreshold": {
			"global": {
				"statements": 80,
				"branches": 80,
				"functions": 80,
				"lines": 80
			}
		}
	}
}
